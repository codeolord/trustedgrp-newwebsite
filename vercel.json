{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/support-widget",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://trustedgrp.com https://www.trustedgrp.com"
        }
      ]
    },
    {
      "source": "/support-widget/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://trustedgrp.com https://www.trustedgrp.com"
        }
      ]
    }
  ]
}
